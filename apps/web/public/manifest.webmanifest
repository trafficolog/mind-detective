{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "MIND Detective",
  "short_name": "MIND Detective",
  "description": "Систематический помощник поиска потерянных вещей с локальным хранением дела.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f6f8",
  "theme_color": "#f4f6f8",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
