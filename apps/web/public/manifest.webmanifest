{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Mind Detective",
  "short_name": "Mind Detective",
  "description": "Системный поиск потерянного: вещь, фото или файл. Дело хранится локально на устройстве.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#EEF7FF",
  "theme_color": "#EEF7FF",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "lang": "ru"
}
