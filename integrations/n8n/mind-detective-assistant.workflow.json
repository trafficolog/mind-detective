        260,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: \"gpt-4o-mini\", temperature: 0.2, response_format: { type: \"json_object\" }, messages: [{ role: \"user\", content: $json.body.prompt }] }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "r1",
      "name": "Respond · proposal",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        -80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { text: $json.choices[0].message.content } }}",
        "options": {}
      }
    },
    {
      "id": "e1",
      "name": "Respond · 502",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        520,
        80
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: \"llm_unavailable\" } }}",
        "options": {
          "responseCode": 502
        }
      }
    },
    {
      "id": "w2",
      "name": "Webhook · transcribe",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        320
      ],
      "webhookId": "md-transcribe",
      "parameters": {
        "httpMethod": "POST",
        "path": "md-transcribe",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*",
          "binaryPropertyName": "file"
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "MD webhook token"
        }
      }
    },
    {
      "id": "h2",
