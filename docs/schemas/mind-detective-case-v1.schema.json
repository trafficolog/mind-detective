{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mind-detective-case-v1.schema.json",
  "title": "MIND Detective Case v1",
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "item_label",
    "created_at",
    "updated_at",
    "lifecycle",
    "statements",
    "timeline",
    "search_checks",
    "candidates",
    "next_action",
    "constraints",
    "outcome"
  ],
  "properties": {
    "schema": {"const": "mind-detective-case/v1"},
    "case_id": {"type": "string", "minLength": 1},
    "item_label": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "lifecycle": {
      "enum": ["active", "paused", "closed_found", "closed_unresolved", "deleted"]
    },
    "statements": {"type": "array"},
    "timeline": {"type": ["object", "null"]},
    "search_checks": {"type": "array"},
    "candidates": {"type": "array"},
    "next_action": {"type": ["object", "null"]},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "outcome": {"type": ["object", "null"]}
  },
  "additionalProperties": false
}
